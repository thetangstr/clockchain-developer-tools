{
  "name": "@clockchain/web-demo",
  "version": "0.1.0",
  "description": "Zero-install browser demo for the Clockchain notarization workflow (deploy behind Cloudflare Access)",
  "license": "MIT",
  "type": "module",
  "main": "dist/server.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b && esbuild src/handshake/browser-agent.ts --bundle --format=iife --outfile=dist/handshake/browser-agent.js",
    "test": "tsc -b && node --test",
    "start": "node dist/server.js",
    "demo:handshake": "node dist/handshake-server.js"
  },
  "dependencies": {
    "@clockchain/core": "0.1.0",
    "@clockchain/mcp-server": "0.1.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "viem": "^2.56.3"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
