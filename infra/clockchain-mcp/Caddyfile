mcp-aws.clockchain.network {
	reverse_proxy mcp:8080
}

mcp.clockchain.network {
	tls {
		on_demand
	}
	# Staging is a path prefix on the production hostname: /staging/* is stripped
	# and proxied to the isolated staging container (no published ports; edge
	# network only). X-Forwarded-Prefix tells the app which public prefix it was
	# reached through so its discovery manifest advertises the real endpoint.
	# Production paths fall through to the mcp service untouched.
	handle_path /staging/* {
		reverse_proxy mcp-staging:8080 {
			header_up X-Forwarded-Prefix /staging
		}
	}
	# ACM4 demo instance: a second MCP server pinned to the build the Clark/Clint pair
	# (helper 2.1.6) is proven against, with its own state and invite limiter. Runs from
	# /opt/clockchain-mcp/acm4-compose.yml on the box; production stays on the main build.
	handle_path /acm4/* {
		reverse_proxy mcp-acm4:8080 {
			header_up X-Forwarded-Prefix /acm4
		}
	}
	# Agent handshake endpoint: /handshake/mcp serves the current build (flipped from the
	# pinned 2.1.6 instance for ACM4 packet #13). The pinned instance remains reachable
	# at /acm4/* for rollback while the frozen pair is pinned there.
	handle /handshake/mcp {
		reverse_proxy mcp:8080
	}
	handle_path /next/* {
		reverse_proxy mcp:8080 {
			header_up X-Forwarded-Prefix /next
		}
	}
	# Telemetry sink (D22): separate authority in its own container (compose
	# profile `telemetry`). Ingest /telemetry/v1/* -> write listener (per-role
	# ingest tokens); /telemetry/query/* -> read listener (query tokens);
	# /telemetry/keys -> the sink's PUBLIC signing key. The close listener is
	# never routed here: only mcp reaches it on clockchain_edge. handle + uri
	# rewrites (not handle_path) so the sink sees its native /v1/* paths.
	handle /telemetry/v1/* {
		uri strip_prefix /telemetry
		reverse_proxy telemetry-sink:8081
	}
	handle /telemetry/keys {
		uri replace /telemetry/keys /v1/keys
		reverse_proxy telemetry-sink:8082
	}
	handle /telemetry/query/* {
		uri replace /telemetry/query /v1
		reverse_proxy telemetry-sink:8082
	}
	reverse_proxy mcp:8080
}
