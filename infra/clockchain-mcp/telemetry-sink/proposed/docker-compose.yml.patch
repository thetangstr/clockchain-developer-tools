--- a/infra/clockchain-mcp/docker-compose.yml
+++ b/infra/clockchain-mcp/docker-compose.yml
@@ -88,6 +88,56 @@
       - host_runs:/app/runs
     restart: unless-stopped
 
+  telemetry-sink:
+    profiles: ["telemetry"]
+    build:
+      context: ../..
+      dockerfile: packages/telemetry-sink/Dockerfile
+    # Sink uid 10001 (image user `sink`); key + token records live on
+    # telemetry_state, generated in-container — never an env or mount.
+    # Profiles keep the default `docker compose up` from touching the sink.
+    user: "10001:10001"
+    environment:
+      TELEMETRY_ENV: "production"
+      TELEMETRY_STATE_DIR: /telemetry/state
+      TELEMETRY_CONTRACT_KEYS: "${TELEMETRY_CONTRACT_KEYS:-}"
+      TELEMETRY_PEER_CONTRACT_KEYS: "${TELEMETRY_CONTRACT_KEYS_STAGING:-}"
+      TELEMETRY_RUN_WINDOW_MS: "${TELEMETRY_RUN_WINDOW_MS:-21600000}"
+      TELEMETRY_FLUSH_GRACE_MS: "${TELEMETRY_FLUSH_GRACE_MS:-30000}"
+    volumes:
+      - telemetry_state:/telemetry/state
+    expose:
+      - "8081"
+      - "8082"
+      - "8083"
+    networks:
+      - clockchain_edge
+    restart: unless-stopped
+
+  telemetry-sink-staging:
+    profiles: ["telemetry"]
+    build:
+      context: ../..
+      dockerfile: packages/telemetry-sink/Dockerfile
+    # Staging uid 10002 (image user `sinkstg`) on its own volume + state dir.
+    user: "10002:10002"
+    environment:
+      TELEMETRY_ENV: "staging"
+      TELEMETRY_STATE_DIR: /telemetry/state-staging
+      TELEMETRY_CONTRACT_KEYS: "${TELEMETRY_CONTRACT_KEYS_STAGING:-}"
+      TELEMETRY_PEER_CONTRACT_KEYS: "${TELEMETRY_CONTRACT_KEYS:-}"
+      TELEMETRY_RUN_WINDOW_MS: "${TELEMETRY_RUN_WINDOW_MS:-21600000}"
+      TELEMETRY_FLUSH_GRACE_MS: "${TELEMETRY_FLUSH_GRACE_MS:-30000}"
+    volumes:
+      - telemetry_state_staging:/telemetry/state-staging
+    expose:
+      - "8081"
+      - "8082"
+      - "8083"
+    networks:
+      - clockchain_edge
+    restart: unless-stopped
+
   caddy:
     image: caddy:2.8-alpine
     depends_on:
@@ -106,6 +156,8 @@
     restart: unless-stopped
 
 volumes:
+  telemetry_state:
+  telemetry_state_staging:
   caddy_data:
   caddy_config:
   host_runs:

