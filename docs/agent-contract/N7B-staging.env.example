# N7b — /contract/mcp staging environment template. PLACEHOLDERS ONLY.
# Copy to the deploy .env on the box and fill per the provisioner named on
# each line. Seed and bearer tokens are provisioned by the founder or the
# operator — never generated into this file, never committed real.
# Reference: packages/mcp-server/src/agent-contract/config.ts.

# --- surface ---
# operator — set to 1 to open /contract/mcp (404s when unset).
CONTRACT_MCP_ENABLED=1
# operator — deployment tier L|S|P; staging runs S, production runs P.
#   At S|P, CONTRACT_REQUIRE_BIND_STATEMENT=1 is mandatory and every host
#   root must be a published production root (check-config enforces both).
CONTRACT_LEVEL=S
# operator — require the bind-statement possession proof at contract_bind.
CONTRACT_REQUIRE_BIND_STATEMENT=1

# --- bearer tokens (secret) ---
# founder — comma-separated token:role:keyId:agentId:side entries; agentId
#   may be "*" for late binding (requires REQUIRE_BIND_STATEMENT=1 above).
#   buyer≡initiator, provider≡responder.
CONTRACT_AUTH_TOKENS=<buyer-token>:buyer:<buyer-keyId>:<agentId-or-*>:initiator,<provider-token>:provider:<provider-keyId>:<agentId-or-*>:responder
# operator — read-only observer receipt feed bearer (must differ from the
#   verifier token). Optional.
CONTRACT_OBSERVER_TOKEN=<observer-token>
# operator — verifier-scoped run-salt disclosure bearer. Optional.
CONTRACT_VERIFIER_TOKEN=<verifier-token>

# --- signing key (secret) ---
# founder — canonical base64 32-byte ed25519 seed; derive the published
#   publicKeyHex from it out-of-band before agents pin /contract/keys.
CONTRACT_SERVER_ED25519_SEED=<base64-32-byte-seed>
# operator — stable keyId for the published key (ignored for ephemeral keys).
CONTRACT_SERVER_KEY_ID=<key-id>
# operator — pinned ISO-8601 start of the published key's validity window;
#   REQUIRED whenever the surface is on (never boot-derived).
CONTRACT_SERVER_KEY_VALID_FROM=<ISO-8601>
# operator — optional ISO-8601 expiry; startup refuses if already past.
# CONTRACT_SERVER_KEY_VALID_UNTIL=<ISO-8601>
# founder ONLY — disposable dev signer; must never be set at level S|P
#   (check-config refuses it there).
# CONTRACT_ALLOW_EPHEMERAL_KEY=1

# --- pins ---
# operator — comma-separated buyer:0x<sha256>,provider:0x<sha256> §13 policy
#   digests; both required.
CONTRACT_POLICY_DIGESTS=buyer:0x<64-hex>,provider:0x<64-hex>
# founder — buyerKeyId:0xaddress family-principal pins; the mandate's
#   EIP-191 signature must recover to the pinned address.
CONTRACT_PRINCIPALS=<buyer-keyId>:0x<40-hex>
# operator — optional override of the published host-root pins
#   (kid:sha256fingerprint); at S|P only root-2026-08 is accepted.
# CONTRACT_HOST_ROOTS=root-2026-08:da2771c36bf2298525d2bbd8351b6122bb67115e9979624e8bb56537bcf71ed8
# operator — optional ERC-8004 deployment pins; both or neither.
# CONTRACT_ERC8004_CHAIN_ID=
# CONTRACT_ERC8004_REGISTRY_ADDRESS=

# --- limits (operator; defaults shown) ---
CONTRACT_CALLS_PER_MINUTE=120
CONTRACT_OBSERVER_PER_MINUTE=30
CONTRACT_MAX_RUNS=1024
CONTRACT_MAX_RECEIPTS_PER_RUN=4096
CONTRACT_MAX_RECEIPTS_PER_PRINCIPAL=512
CONTRACT_RUN_TTL_MS=86400000
CONTRACT_CERT_GRACE_MS=600000
CONTRACT_SESSION_TTL_MS=1800000

# --- state + proxy ---
# operator — run/receipt/binding state dir on the mcp_state volume.
CONTRACT_STATE_DIR=/app/state/contract
# operator — trust X-Forwarded-For for evidence sourceIp (edge = caddy only).
# CONTRACT_TRUST_PROXY=1

# --- adverse-case sim faults (founder decision; off by default) ---
# founder — gate; without it CONTRACT_SIM_FAULTS misconfigures the surface.
# CONTRACT_ALLOW_SIM_FAULTS=1
# founder — JSON {"<runId>":{"issueMismatch":"fare"|"travellers"}}; when set
#   the server card discloses simFaultsEnabled and faulted runs stamp
#   simFault on every receipt.
# CONTRACT_SIM_FAULTS={"<runId>":{"issueMismatch":"fare"}}

# --- sink pairing (N7a; operator — value comes from the sink deploy) ---
# The compose-network close URL the contract server POSTs terminal receipts
# to. Consumed by the host wiring when the sink pairing lands (N6); recorded
# here so the staging env is complete when it does.
# TELEMETRY_CLOSE_URL=http://telemetry-sink-staging:8083
